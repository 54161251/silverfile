# Copy to .env and fill in. Never commit .env.
# Staff sign-in for the dashboard (synthetic demo values)
SILVERFILE_STAFF_IDS=demo_staff,staff_jlee
SILVERFILE_STAFF_PASSCODE=silverfile-demo
# Optional: where sessions are saved
SILVERFILE_DB=runtime/sessions.sqlite
# Model key for agents that call an LLM (Intake, Extraction). Leave blank for the offline demo.
ANTHROPIC_API_KEY=
# Model for Intake's document briefing (spec 4.5 batch). R18: cheaper model for development,
# the stronger one for eval runs and the demo. Optional: unset or blank means claude-opus-5-5.
SILVERFILE_MODEL=claude-opus-5-5
# Server-side refusal fallback for the briefing call; leave empty to turn it off.
SILVERFILE_REFUSAL_FALLBACK=default
